{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^generate", "generate"],
      "env": [
        "NEXT_PUBLIC_GOOGLE_MAP_API_KEY",
        "NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN",
        "NEXT_PUBLIC_VERCEL_URL",
        "OPEN_DATA_CWB_API_KEY",
        "OPEN_DATA_CWB_BASE_URL",
        "TDX_BASE_URL",
        "TDX_CLIENT_ID",
        "TDX_CLIENT_SECRET"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env.*local", "$TURBO_ROOT$/.env*.local"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^generate", "generate"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": true,
      "inputs": ["scripts/**", "specs/**", "package.json"],
      "outputs": ["generated/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"],
      "outputs": []
    }
  }
}
