{
  "name": "f2e",
  "private": true,
  "description": "A collection of unlicensed work for f2e open challenge",
  "keywords": [
    "template",
    "next.js",
    "typescript",
    "chakra-ui",
    "framer-motion",
    "redux",
    "redux-toolkit",
    "rtk-query",
    "lint-staged",
    "husky",
    "commitlint"
  ],
  "homepage": "https://github.com/Howard86/f2e-2011",
  "bugs": {
    "url": "https://github.com/Howard86/f2e-2011/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Howard86/f2e-2011"
  },
  "license": "UNLICENSED",
  "author": "Howard Tai <howard@howardism.dev>",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:bus": "turbo run build --filter=@f2e/bus",
    "build:scene": "turbo run build --filter=@f2e/scene",
    "build:ubike": "turbo run build --filter=@f2e/ubike",
    "check": "ultracite check",
    "dev:bus": "turbo run dev --filter=@f2e/bus",
    "dev:scene": "turbo run dev --filter=@f2e/scene",
    "dev:ubike": "turbo run dev --filter=@f2e/ubike",
    "fix": "ultracite fix",
    "generate:tdx": "turbo run generate",
    "knip": "knip",
    "prepare": "husky",
    "start:bus": "turbo run start --filter=@f2e/bus",
    "start:scene": "turbo run start --filter=@f2e/scene",
    "start:ubike": "turbo run start --filter=@f2e/ubike",
    "typecheck": "turbo run typecheck",
    "update:tdx-specs": "bun run --filter '@f2e/tdx-*' update-specs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "knip": "6.44.1",
    "lint-staged": "^17.6.0",
    "turbo": "2.11.10",
    "typescript": "~6.0.3",
    "ultracite": "8.1.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
