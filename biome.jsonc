{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": ["!apps/scene/public/static/logo.svg", "!libs/tdx*/specs"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        // Ultracite treats any `*.Label` as a <label>; Chakra's Tag.Label is a
        // <span> and Field.Label is bound to its control via Field.Root.
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "labelComponents": [] }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["libs/tdx*/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/scene/src/types/local.d.ts",
        "apps/scene/src/types/open-data.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off"
          }
        }
      }
    }
  ]
}
